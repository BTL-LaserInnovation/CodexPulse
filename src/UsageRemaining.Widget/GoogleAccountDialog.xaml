<Window x:Class="UsageRemaining.Widget.GoogleAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:UsageRemaining.Widget.Services"
        Title="Google 캘린더 계정" Icon="pack://application:,,,/CodexPulse;component/Assets/CodexPulse.ico"
        Width="360" SizeToContent="Height" MaxHeight="640" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True" FontSize="10">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#242F52" Offset="0" /><GradientStop Color="#181F40" Offset="0.6" /><GradientStop Color="#30264D" Offset="1" /></LinearGradientBrush>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="10" /></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="10" /></Style>
    </Window.Resources>
    <Border CornerRadius="18" Margin="5" BorderBrush="#5A5984" BorderThickness="1" Background="{services:BackgroundBrush Brush={StaticResource DialogGradient}}">
        <Grid Margin="17,15"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="34" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Height="28" Background="Transparent" MouseLeftButtonDown="Dialog_Drag"><Grid Width="16" Height="16" Margin="0,0,8,0"><Border CornerRadius="3" BorderThickness="1.4" BorderBrush="{StaticResource SkyBrush}" /><Path Data="M 0,5 L 16,5 M 4,0 L 4,3 M 12,0 L 12,3" Stroke="{StaticResource SkyBrush}" StrokeThickness="1.4" /><TextBlock Text="G" FontSize="8" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Grid><TextBlock Text="Google 캘린더" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
            <Border Grid.Row="1" CornerRadius="10" Padding="10,9" Margin="0,8,0,9" Background="{services:BackgroundBrush Brush=#2D3559}" BorderBrush="#565680" BorderThickness="1"><StackPanel><TextBlock x:Name="AccountText" Text="연결된 계정 없음" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="AccountHintText" Text="브라우저에서 Google 계정을 선택합니다." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
            <StackPanel Grid.Row="2"><TextBlock x:Name="ConfigurationText" Foreground="{StaticResource CoralBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8" Visibility="Collapsed" /><Grid x:Name="ConnectionActions" Height="31"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="ConnectButton" Content="Google로 로그인" Foreground="{StaticResource MintBrush}" Background="#414C69" BorderBrush="#6D88A0" Click="Connect_Click" /><Button x:Name="DisconnectButton" Grid.Column="2" Content="연결 해제" Foreground="{StaticResource CoralBrush}" Background="#303858" BorderBrush="#555E80" Click="Disconnect_Click" /></Grid></StackPanel>
            <StackPanel x:Name="CalendarPanel" Grid.Row="3" Margin="0,15,0,0"><TextBlock Text="위젯에 표시할 캘린더" FontWeight="SemiBold" /><TextBlock Text="읽기 전용 캘린더의 일정도 볼 수 있습니다." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" /><Border BorderBrush="#4D5D86" BorderThickness="1" CornerRadius="8" Padding="10,4" Background="{services:BackgroundBrush Brush=#202B50}"><ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CalendarList" /></ScrollViewer></Border><TextBlock x:Name="EmptyCalendarsText" Text="표시할 캘린더가 없습니다." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" Visibility="Collapsed" /></StackPanel>
            <TextBlock x:Name="SecurityText" Grid.Row="4" Text="비밀번호는 이 앱에 입력하지 않습니다. 연결 정보는 이 컴퓨터에 보호되어 저장됩니다." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="{StaticResource CoralBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,8" />
            <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="선택 저장" Foreground="{StaticResource MintBrush}" Background="#414C69" BorderBrush="#6D88A0" Click="Save_Click" /><Button x:Name="CancelButton" Grid.Column="2" Content="닫기" IsCancel="True" Background="#303858" BorderBrush="#555E80" Click="Cancel_Click" /></Grid>
        </Grid>
    </Border>
</Window>
