<Window x:Class="UsageRemaining.Widget.GoogleActionConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:UsageRemaining.Widget.Services"
        Title="Google 캘린더 확인" Icon="pack://application:,,,/CodexPulse;component/Assets/CodexPulse.ico"
        Width="350" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Border CornerRadius="18" Margin="5" Padding="18,16" BorderBrush="#5A5984" BorderThickness="1" Background="{services:BackgroundBrush Brush=#202B50}" MouseLeftButtonDown="Dialog_Drag">
        <StackPanel><TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="DescriptionText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,16" TextWrapping="Wrap" LineHeight="17" /><Grid Height="33"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="ConfirmButton" Foreground="{StaticResource CoralBrush}" Background="#414C69" BorderBrush="#6D88A0" Click="Confirm_Click" /><Button x:Name="CancelButton" Grid.Column="2" Content="취소" IsCancel="True" IsDefault="True" Background="#303858" BorderBrush="#555E80" Click="Cancel_Click" /></Grid></StackPanel>
    </Border>
</Window>
