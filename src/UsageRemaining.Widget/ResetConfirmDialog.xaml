<Window x:Class="UsageRemaining.Widget.ResetConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:UsageRemaining.Widget.Services"
        Title="리셋권 사용 확인" Icon="pack://application:,,,/CodexPulse;component/Assets/CodexPulse.ico"
        Width="330" Height="285" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI, Malgun Gothic" UseLayoutRounding="True"
        AutomationProperties.Name="리셋권 사용 확인">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#242F52" Offset="0" /><GradientStop Color="#181F40" Offset="0.6" /><GradientStop Color="#30264D" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>
    <Border CornerRadius="18" Margin="5" BorderBrush="#5A5984" BorderThickness="1" MouseLeftButtonDown="Dialog_Drag"
            Background="{services:BackgroundBrush Brush={StaticResource DialogGradient}}">
        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="26" /><RowDefinition Height="24" /><RowDefinition Height="54" />
                <RowDefinition Height="*" /><RowDefinition Height="27" /><RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="DialogLogo" Source="{StaticResource AppMark}" Width="14" Height="14" Margin="0,0,7,0"
                       VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False" Focusable="False" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="리셋권을 사용할까요?" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="DialogAccountText" Grid.Row="1" Text="사용 계정" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Border Grid.Row="2" Background="{services:BackgroundBrush Brush=#2D3559}" BorderBrush="#565680" BorderThickness="1" CornerRadius="10" Padding="10,7">
                <StackPanel>
                    <TextBlock x:Name="DialogCreditText" Text="리셋권" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource VioletBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DialogExpiryText" Text="유효 기간 확인 중" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="DialogDescriptionText" Grid.Row="3" Text="선택한 리셋권을 사용해 현재 사용량 한도를 초기화합니다." FontSize="10" LineHeight="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
            <TextBlock x:Name="DialogStatusText" Grid.Row="4" FontSize="9" Foreground="{StaticResource CoralBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="ConfirmResetButton" Content="리셋권 사용" Background="#414C69" BorderBrush="#6D88A0" Foreground="{StaticResource MintBrush}" Click="Confirm_Click" AutomationProperties.Name="선택한 리셋권 사용" />
                <Button x:Name="CancelResetButton" Grid.Column="2" Content="취소" Background="#303858" BorderBrush="#555E80" IsCancel="True" Click="Cancel_Click" AutomationProperties.Name="리셋권 사용 취소" />
            </Grid>
        </Grid>
    </Border>
</Window>
