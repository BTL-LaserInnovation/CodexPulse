<Window x:Class="UsageRemaining.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:UsageRemaining.Widget.Services"
        Title="Codex Pulse" Icon="pack://application:,,,/CodexPulse;component/Assets/CodexPulse.ico"
        Width="360" Height="480" MinWidth="360" MinHeight="80"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" UseLayoutRounding="True"
        AutomationProperties.Name="Codex 남은 사용량 위젯">
    <Window.Resources>
        <LinearGradientBrush x:Key="WidgetGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#20294D" Offset="0" />
            <GradientStop Color="#141D3C" Offset="0.65" />
            <GradientStop Color="#27234B" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#14213D" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="UpdateSurface" CornerRadius="6" BorderBrush="#B8E8ED" BorderThickness="1" Padding="2,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <LinearGradientBrush.RelativeTransform>
                                        <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#8BE5CF" Offset="0" />
                                    <GradientStop Color="#9BD5F5" Offset="0.5" />
                                    <GradientStop Color="#C4B5F5" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="UpdateGradientMotion">
                                        <Storyboard Duration="0:0:6" RepeatBehavior="Forever">
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="UpdateSurface"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                                <SplineColorKeyFrame KeyTime="0:0:3" Value="#A8D9F5" KeySpline="0.4,0,0.6,1" />
                                                <SplineColorKeyFrame KeyTime="0:0:6" Value="#8BE5CF" KeySpline="0.4,0,0.6,1" />
                                            </ColorAnimationUsingKeyFrames>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="UpdateSurface"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                                <SplineColorKeyFrame KeyTime="0:0:3" Value="#C4B5F5" KeySpline="0.4,0,0.6,1" />
                                                <SplineColorKeyFrame KeyTime="0:0:6" Value="#9BD5F5" KeySpline="0.4,0,0.6,1" />
                                            </ColorAnimationUsingKeyFrames>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="UpdateSurface"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)">
                                                <SplineColorKeyFrame KeyTime="0:0:3" Value="#8BE5CF" KeySpline="0.4,0,0.6,1" />
                                                <SplineColorKeyFrame KeyTime="0:0:6" Value="#C4B5F5" KeySpline="0.4,0,0.6,1" />
                                            </ColorAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpdateSurface"
                                                Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(RotateTransform.Angle)">
                                                <SplineDoubleKeyFrame KeyTime="0:0:3" Value="8" KeySpline="0.4,0,0.6,1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:6" Value="0" KeySpline="0.4,0,0.6,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="UpdateGradientMotion" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UpdateSurface" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="UpdateSurface" Property="BorderBrush" Value="#14213D" />
                                <Setter TargetName="UpdateSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UpdateSurface" Property="BorderBrush" Value="#14213D" />
                                <Setter TargetName="UpdateSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WidgetSurface" CornerRadius="20" Margin="6" BorderBrush="#3C4A77" BorderThickness="1"
            Background="{services:BackgroundBrush Brush={StaticResource WidgetGradient}}"
            PreviewMouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <Grid Margin="14,8">
            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="빈 곳을 끌어 이동" VerticalAlignment="Center">
                    <Image x:Name="AppLogo" Source="{StaticResource AppMark}" Width="16" Height="16" Margin="0,0,6,0"
                           VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False" Focusable="False" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Codex Pulse" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="UpdateButton" Content="Update" Width="44" Height="20" Margin="6,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="Update_Click"
                            Style="{StaticResource UpdateButtonStyle}" services:BackgroundOpacity.Value="1" Opacity="1"
                            ToolTip="Update Codex Pulse" AutomationProperties.Name="Update Codex Pulse" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="TopmostCheck" Content="고정" VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="Topmost_Changed" Unchecked="Topmost_Changed" ToolTip="항상 위에 표시" AutomationProperties.Name="항상 위에 표시" />
                    <Slider x:Name="OpacitySlider" Width="36" Minimum="0.55" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1"
                            ValueChanged="Opacity_Changed" ToolTip="배경 불투명도 100% (투명도 0%)" AutomationProperties.Name="배경 투명도" Margin="0,0,4,0" />
                    <Button x:Name="CollapseButton" Width="24" Height="24" Padding="0" Click="ToggleCollapse_Click" ToolTip="접기" AutomationProperties.Name="위젯 접기">
                        <Path x:Name="CollapseIcon" Data="M 0,5 L 4,1 8,5" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Width="24" Height="24" Padding="0" Click="Close_Click" ToolTip="닫기" AutomationProperties.Name="닫기">
                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{StaticResource CoralBrush}" StrokeThickness="1.3" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedPanel" Grid.Row="1" Height="416" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" /><RowDefinition Height="90" /><RowDefinition Height="24" />
                    <RowDefinition Height="16" /><RowDefinition Height="126" /><RowDefinition Height="40" />
                    <RowDefinition Height="18" /><RowDefinition Height="54" /><RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="AccountText" Text="계정 연결 대기" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,7,0" />
                    <Border Grid.Column="1" Background="{services:BackgroundBrush Brush=#353656}" BorderBrush="#5E5682" BorderThickness="1" CornerRadius="6" Padding="6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlanText" Text="플랜 확인 전" FontSize="9" Foreground="{StaticResource VioletBrush}" MaxWidth="100" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{services:BackgroundBrush Brush=#243452}" BorderBrush="#405E6C" BorderThickness="1" CornerRadius="12" Padding="9,4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="14" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="4" /><RowDefinition Height="4" /></Grid.RowDefinitions>
                            <TextBlock x:Name="PrimaryName" Text="한도 정보 없음" Foreground="{StaticResource MintBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PrimaryPercent" Grid.Row="1" Text="—" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="첫 번째 한도 남은 사용량" />
                            <TextBlock x:Name="PrimaryReset" Grid.Row="2" Text="연결 후 표시" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="NoWrap" LineHeight="13" LineStackingStrategy="BlockLineHeight" />
                            <ProgressBar x:Name="PrimaryProgress" Grid.Row="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource MintBrush}" AutomationProperties.Name="첫 번째 한도 남은 사용량 비율" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{services:BackgroundBrush Brush=#2B2F56}" BorderBrush="#544A7B" BorderThickness="1" CornerRadius="12" Padding="9,4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="14" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="4" /><RowDefinition Height="4" /></Grid.RowDefinitions>
                            <TextBlock x:Name="SecondaryName" Text="한도 정보 없음" Foreground="{StaticResource VioletBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SecondaryPercent" Grid.Row="1" Text="—" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="두 번째 한도 남은 사용량" />
                            <TextBlock x:Name="SecondaryReset" Grid.Row="2" Text="연결 후 표시" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="NoWrap" LineHeight="13" LineStackingStrategy="BlockLineHeight" />
                            <ProgressBar x:Name="SecondaryProgress" Grid.Row="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource VioletBrush}" AutomationProperties.Name="두 번째 한도 남은 사용량 비율" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MonthText" Text="이번 달" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="표시 중인 달" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="23" Padding="0" Click="PreviousMonth_Click" ToolTip="이전 달" AutomationProperties.Name="이전 달">
                            <Path Data="M 5,0 L 0,5 5,10" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" />
                        </Button>
                        <Button Padding="5,0" Click="Today_Click" Content="오늘" FontSize="10" Foreground="{StaticResource MutedBrush}" AutomationProperties.Name="오늘로 이동" />
                        <Button Width="23" Padding="0" Click="NextMonth_Click" ToolTip="다음 달" AutomationProperties.Name="다음 달">
                            <Path Data="M 0,0 L 5,5 0,10" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
                <UniformGrid Grid.Row="3" Columns="7" VerticalAlignment="Center">
                    <TextBlock Text="일" Foreground="{StaticResource CoralBrush}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Text="월" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Text="화" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Text="수" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Text="목" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Text="금" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Text="토" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" FontSize="9" />
                </UniformGrid>
                <UniformGrid x:Name="DaysPanel" Grid.Row="4" Columns="7" Rows="6" AutomationProperties.Name="사용량 초기화 달력" />

                <Grid Grid.Row="5">
                    <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedDateText" Text="날짜를 선택하세요" FontWeight="SemiBold" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                        <StackPanel x:Name="CalendarLegend" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip="흰색 테두리는 선택한 날짜이고, 날짜 안의 색상 점은 기록 종류입니다. 출처: OpenTheRank(제삼자 기록). 리셋: 출처 달력에 기록된 리셋 적용. 리셋권: 공개 지급 발표이며 내 계정 지급 확인이 아닙니다. 예고: 사전 발표가 게시된 시각이며 적용 시각이나 확정 일정이 아닙니다. 내 예정: 연결된 계정의 다음 초기화 시각입니다.">
                            <Ellipse Width="4" Height="4" Fill="{StaticResource MintBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="리셋" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                            <Ellipse Width="4" Height="4" Fill="{StaticResource VioletBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="리셋권" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                            <Ellipse Width="4" Height="4" Fill="{StaticResource SkyBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="예고" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                            <Ellipse Width="5" Height="5" Stroke="{StaticResource CoralBrush}" StrokeThickness="1" Margin="0,0,3,0" />
                            <TextBlock Text="내 예정" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <TextBlock x:Name="DetailText" Text="공개 이력과 내 초기화 일정을 함께 확인하세요." Foreground="{StaticResource MutedBrush}" FontSize="9" LineHeight="11" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CreditsTitle" Text="리셋권" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PublicStatusText" Grid.Column="1" Text="공개 자료" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="6,0,3,0" ToolTip="달력의 공개 이력은 개인 사용 이력이 아닙니다." />
                    <Button x:Name="SourceButton" Grid.Column="2" Content="출처 ↗" FontSize="9" Foreground="{StaticResource VioletBrush}" Padding="3,0" Click="OpenSource_Click" ToolTip="공개 자료 출처 열기" AutomationProperties.Name="공개 이력 출처 열기" />
                </Grid>
                <Grid Grid.Row="7">
                    <ScrollViewer x:Name="CreditScroll" MaxHeight="50" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" AutomationProperties.Name="리셋권 목록">
                        <StackPanel x:Name="CreditList" />
                    </ScrollViewer>
                    <TextBlock x:Name="CreditsHint" Text="계정을 연결하면 리셋권을 확인할 수 있습니다." FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4" />
                </Grid>

                <Grid Grid.Row="8" ToolTip="공개 달력은 OpenTheRank의 제삼자 기록입니다. 내 계정의 한도·리셋권은 연결된 Codex 계정에서 확인합니다.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource CoralBrush}" Margin="0,0,5,0" />
                            <TextBlock x:Name="StatusText" Text="연결 대기" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="187" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <TextBlock x:Name="UpdatedText" Text="아직 동기화하지 않았습니다" FontSize="8" Foreground="#A4B4DE" Margin="10,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="195" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FooterRefreshButton" Width="25" Height="24" Padding="0" Foreground="{StaticResource MintBrush}" Click="Refresh_Click" ToolTip="새로 고침" AutomationProperties.Name="새로 고침">
                            <Path Data="M 10,3 A 5,5 0 1 0 11,8 M 10,0 L 10,4 6,4" Stroke="{StaticResource MintBrush}" StrokeThickness="1.4" />
                        </Button>
                        <Button x:Name="ConnectButton" Height="24" Content="연결" Margin="3,0,0,0" Background="#374A68" Foreground="{StaticResource MintBrush}" Click="Connect_Click" AutomationProperties.Name="Codex 계정 연결" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="CompactPanel" Grid.Row="1" Height="28" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition x:Name="CompactSecondaryRow" Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CompactName" Text="사용 한도" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="CompactPercent" Grid.Column="1" Text="—%" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ProgressBar x:Name="CompactProgress" Grid.Column="2" Height="4" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" AutomationProperties.Name="사용 한도 남은 사용량 비율" />
                <TextBlock x:Name="CompactReset" Grid.Column="3" Text="한도 정보 없음" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" MaxWidth="100" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CompactSecondaryName" Grid.Row="1" Text="" FontSize="10" Foreground="{StaticResource VioletBrush}" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed" />
                <TextBlock x:Name="CompactSecondaryPercent" Grid.Row="1" Grid.Column="1" Text="" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" Visibility="Collapsed" />
                <ProgressBar x:Name="CompactSecondaryProgress" Grid.Row="1" Grid.Column="2" Height="4" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Foreground="{StaticResource VioletBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="CompactSecondaryReset" Grid.Row="1" Grid.Column="3" Text="" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" MaxWidth="100" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>
