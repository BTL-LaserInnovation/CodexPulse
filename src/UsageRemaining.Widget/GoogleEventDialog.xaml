<Window x:Class="UsageRemaining.Widget.GoogleEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:services="clr-namespace:UsageRemaining.Widget.Services"
        Title="Google 일정" Icon="pack://application:,,,/CodexPulse;component/Assets/CodexPulse.ico"
        Width="360" SizeToContent="Height" MaxHeight="720" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI, Malgun Gothic" UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="DialogGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#242F52" Offset="0" /><GradientStop Color="#181F40" Offset="0.6" /><GradientStop Color="#30264D" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="CaretBrush" Value="{StaticResource MintBrush}" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#59668D" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="FieldBorder" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{services:BackgroundBrush Brush=#202B50}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource MintBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DateCalendarDay" TargetType="primitives:CalendarDayButton">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" /><Setter Property="MinWidth" Value="31" /><Setter Property="MinHeight" Value="29" />
            <Setter Property="Margin" Value="2" /><Setter Property="FocusVisualStyle" Value="{StaticResource CalendarFocusOutline}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarDayButton">
                <Border x:Name="DaySurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#7D89AD" /></Trigger>
                    <Trigger Property="IsToday" Value="True"><Setter TargetName="DaySurface" Property="BorderBrush" Value="{StaticResource VioletBrush}" /><Setter Property="Foreground" Value="{StaticResource VioletBrush}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DaySurface" Property="Background" Value="#35436E" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="DaySurface" Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="Foreground" Value="#152B39" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DaySurface" Property="BorderBrush" Value="{StaticResource TextBrush}" /></Trigger>
                    <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.3" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DateCalendarPeriod" TargetType="primitives:CalendarButton">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="50" /><Setter Property="MinHeight" Value="45" /><Setter Property="Margin" Value="3" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CalendarFocusOutline}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarButton">
                <Border x:Name="PeriodSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#7D89AD" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PeriodSurface" Property="Background" Value="#35436E" /></Trigger>
                    <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="PeriodSurface" Property="Background" Value="#3F385F" /><Setter Property="Foreground" Value="{StaticResource VioletBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PeriodSurface" Property="BorderBrush" Value="{StaticResource MintBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DateCalendarItem" TargetType="primitives:CalendarItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarItem">
                <ControlTemplate.Resources><DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></ControlTemplate.Resources>
                <Border Background="{TemplateBinding Background}" BorderBrush="#68749C" BorderThickness="1" CornerRadius="12" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <Button x:Name="PART_PreviousButton" Width="28" Height="28" ToolTip="이전" AutomationProperties.Name="이전 월 또는 기간"><Path Data="M 6,0 L 0,5 6,10" Stroke="{StaticResource MintBrush}" StrokeThickness="1.5" /></Button>
                        <Button x:Name="PART_HeaderButton" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" ToolTip="월 / 연도 선택" HorizontalAlignment="Stretch" />
                        <Button x:Name="PART_NextButton" Grid.Column="2" Width="28" Height="28" ToolTip="다음" AutomationProperties.Name="다음 월 또는 기간"><Path Data="M 0,0 L 6,5 0,10" Stroke="{StaticResource MintBrush}" StrokeThickness="1.5" /></Button>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="33" /><RowDefinition Height="33" /><RowDefinition Height="33" /><RowDefinition Height="33" /><RowDefinition Height="33" /><RowDefinition Height="33" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Height="222" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DateCalendar" TargetType="Calendar">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Language" Value="ko-KR" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{services:BackgroundBrush Brush=#202B50}" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DateCalendarDay}" /><Setter Property="CalendarButtonStyle" Value="{StaticResource DateCalendarPeriod}" /><Setter Property="CalendarItemStyle" Value="{StaticResource DateCalendarItem}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Language" Value="en-CA" /><Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="CalendarStyle" Value="{StaticResource DateCalendar}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
                <Grid x:Name="PART_Root">
                    <Border x:Name="DateSurface" CornerRadius="6" BorderBrush="#59668D" BorderThickness="1" Background="{services:BackgroundBrush Brush=#202B50}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="31" /></Grid.ColumnDefinitions>
                            <primitives:DatePickerTextBox x:Name="PART_TextBox" Foreground="{TemplateBinding Foreground}" CaretBrush="{StaticResource MintBrush}" FontSize="{TemplateBinding FontSize}" Padding="8,6" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center">
                                <primitives:DatePickerTextBox.Template><ControlTemplate TargetType="primitives:DatePickerTextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></ControlTemplate></primitives:DatePickerTextBox.Template>
                            </primitives:DatePickerTextBox>
                            <Button x:Name="PART_Button" Grid.Column="1" Margin="1,2,3,2" Padding="5" ToolTip="달력 열기 · Alt+↓" AutomationProperties.Name="날짜 선택 달력 열기">
                                <Grid Width="14" Height="14"><Border BorderBrush="{StaticResource MintBrush}" BorderThickness="1.2" CornerRadius="2" Margin="0,2,0,0" /><Path Data="M 0,6 L 14,6 M 4,0 L 4,4 M 10,0 L 10,4" Stroke="{StaticResource MintBrush}" StrokeThickness="1.2" /><Border Width="3" Height="3" Background="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" /></Grid>
                            </Button>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" StaysOpen="False" AllowsTransparency="True" Margin="0,4,0,0" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DateSurface" Property="BorderBrush" Value="{StaticResource MintBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DateSurface" Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Padding" Value="8,6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#3B4A75" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#354767" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="29" /><Setter Property="BorderBrush" Value="#59668D" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <Border CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{services:BackgroundBrush Brush=#202B50}" />
                <ContentPresenter Margin="8,5,24,5" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path Data="M 0,0 L 4,4 8,0" Stroke="#B3BFDF" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" /></Grid></ControlTemplate></ToggleButton.Template></ToggleButton>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220" services:BackgroundOpacity.Value="{Binding Path=(services:BackgroundOpacity.Value), RelativeSource={RelativeSource TemplatedParent}}" Background="{services:BackgroundBrush Brush=#202B50}" BorderBrush="#59668D" BorderThickness="1" CornerRadius="6"><ScrollViewer CanContentScroll="True"><ItemsPresenter /></ScrollViewer></Border></Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Cursor="Hand" FocusVisualStyle="{StaticResource FocusOutline}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2,4">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path x:Name="Chevron" Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3" Width="8" Height="5" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                    </Path>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource MintBrush}" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="18" Margin="5" BorderBrush="#5A5984" BorderThickness="1" Background="{services:BackgroundBrush Brush={StaticResource DialogGradient}}">
        <Grid Margin="17,15">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="34" /></Grid.RowDefinitions>
            <Grid Height="27" Background="Transparent" MouseLeftButtonDown="Dialog_Drag">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" Margin="0,0,8,0"><Border CornerRadius="3" BorderThickness="1.4" BorderBrush="{StaticResource SkyBrush}" /><Path Data="M 0,5 L 16,5 M 4,0 L 4,3 M 12,0 L 12,3" Stroke="{StaticResource SkyBrush}" StrokeThickness="1.4" /><TextBlock Text="G" FontSize="8" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Grid>
                <TextBlock x:Name="HeadingText" Grid.Column="1" Text="새 Google 일정" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="ReadOnlyBadge" Grid.Column="2" CornerRadius="5" BorderBrush="#69779D" BorderThickness="1" Padding="5,2" Visibility="Collapsed"><TextBlock Text="읽기 전용" FontSize="9" Foreground="{StaticResource MutedBrush}" /></Border>
            </Grid>
            <TextBlock x:Name="TimeZoneText" Grid.Row="1" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EditorPanel" Margin="0,0,3,0">
                    <TextBlock Text="제목" Margin="0,0,0,4" /><TextBox x:Name="TitleInput" MaxLength="1024" AutomationProperties.Name="일정 제목" />
                    <TextBlock Text="캘린더" Margin="0,10,0,4" /><ComboBox x:Name="CalendarInput" AutomationProperties.Name="일정 캘린더"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Grid Margin="0,11,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="시작 / 종료" /><CheckBox x:Name="AllDayInput" Grid.Column="1" Content="종일" Checked="AllDay_Changed" Unchecked="AllDay_Changed" /></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions><DatePicker x:Name="StartDateInput" ToolTip="시작 날짜 · 달력 선택 또는 yyyy-MM-dd 입력" AutomationProperties.Name="시작 날짜 yyyy-MM-dd" CalendarOpened="DatePicker_Opened" DateValidationError="DatePicker_ValidationError" SelectedDateChanged="DatePicker_SelectedDateChanged" /><TextBox x:Name="StartTimeInput" Grid.Column="2" ToolTip="시작 시간 · HH:mm" AutomationProperties.Name="시작 시간 HH:mm" /></Grid>
                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions><DatePicker x:Name="EndDateInput" ToolTip="종료 날짜 · 달력 선택 또는 yyyy-MM-dd 입력 · 종일 일정은 마지막 날" AutomationProperties.Name="종료 날짜 yyyy-MM-dd" CalendarOpened="DatePicker_Opened" DateValidationError="DatePicker_ValidationError" SelectedDateChanged="DatePicker_SelectedDateChanged" /><TextBox x:Name="EndTimeInput" Grid.Column="2" ToolTip="종료 시간 · HH:mm" AutomationProperties.Name="종료 시간 HH:mm" /></Grid>
                    <TextBlock x:Name="DateHintText" Text="날짜 yyyy-MM-dd · 시간 HH:mm" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <StackPanel x:Name="ScopePanel" Visibility="Collapsed"><TextBlock Text="변경 범위" Margin="0,10,0,4" /><ComboBox x:Name="ScopeInput" SelectedIndex="0" SelectionChanged="Scope_Changed"><ComboBoxItem Content="이 일정만" /><ComboBoxItem Content="반복 일정 전체" /></ComboBox><TextBlock Text="전체 변경은 반복의 시작 날짜를 유지합니다." FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    <TextBlock Text="반복" Margin="0,10,0,4" /><ComboBox x:Name="RepeatInput" SelectedIndex="0"><ComboBoxItem Content="반복 안 함" /><ComboBoxItem Content="매일" /><ComboBoxItem Content="매주" /><ComboBoxItem Content="매월" /><ComboBoxItem Content="기존 반복 유지" /></ComboBox>
                    <TextBlock Text="알림" Margin="0,10,0,4" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions><ComboBox x:Name="ReminderInput" SelectedIndex="0" SelectionChanged="Reminder_Changed"><ComboBoxItem Content="캘린더 기본 알림" /><ComboBoxItem Content="알림 없음" /><ComboBoxItem Content="시작 전 (분)" /><ComboBoxItem Content="기존 알림 유지" /></ComboBox><TextBox x:Name="ReminderMinutesInput" Grid.Column="2" Text="10" IsEnabled="False" ToolTip="시작 몇 분 전 · 0–40320" AutomationProperties.Name="알림 분" /></Grid>
                    <Expander Header="장소 · 설명" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"><StackPanel Margin="0,7,0,0"><TextBlock Text="장소" Margin="0,0,0,4" /><TextBox x:Name="LocationInput" MaxLength="2048" AutomationProperties.Name="일정 장소" /><TextBlock Text="설명" Margin="0,9,0,4" /><TextBox x:Name="DescriptionInput" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="일정 설명" /></StackPanel></Expander>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource CoralBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,8" />
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="7" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions><Button x:Name="DeleteButton" Content="삭제" Foreground="{StaticResource CoralBrush}" Padding="9,3" Click="Delete_Click" /><Button x:Name="SaveButton" Grid.Column="2" Content="저장" Background="#414C69" BorderBrush="#6D88A0" Foreground="{StaticResource MintBrush}" Click="Save_Click" /><Button x:Name="CancelButton" Grid.Column="4" Content="취소" IsCancel="True" IsDefault="True" Background="#303858" BorderBrush="#555E80" Click="Cancel_Click" /></Grid>
        </Grid>
    </Border>
</Window>
